# 실제 설정 (샘플만 커밋한다)
/config/config.php

# 업로드된 첨부
/storage/uploads/*
!/storage/uploads/.gitkeep

# 배포물에는 vendor/ 를 포함해 올리지만, 저장소에는 커밋하지 않는다
/vendor/

# 로컬 테스트 DB
*.sqlite
*.sqlite3

# 스키마를 옮기기 전 백업과 진행 표식
/storage/backups/
/storage/upgrade.lock
/storage/upgrade-failed.json
/storage/backup.lock
/storage/extensions/

# 로그
/storage/logs/*
!/storage/logs/.gitkeep

# 작업 중 만든 캐시 스냅샷
/storage/cache/*
!/storage/cache/.gitkeep

# CMS 편집기에서 업로드한 이미지
/storage/editor/*
!/storage/editor/.gitkeep

# 회원 프로필 이미지
/storage/avatars/*

.DS_Store

# SDD 진행 기록 (스크래치)
/.superpowers/

/.phpunit.cache/
/phpunit.xml
